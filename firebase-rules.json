{
  "rules": {
    "$other": { ".read": false, ".write": false },

    "users":         { ".read": "auth != null", ".write": "auth != null" },
    "schedule":      { ".read": "auth != null", ".write": "auth != null" },
    "config":        { ".read": "auth != null", ".write": "auth != null" },
    "chat":          { ".read": "auth != null", ".write": "auth != null", ".indexOn": ["timestamp"] },
    "history":       { ".read": "auth != null", ".write": "auth != null" },
    "cleaning":      { ".read": "auth != null", ".write": "auth != null" },

    "machine":       { ".read": true,           ".write": true },
    "esp32_status":  { ".read": true,           ".write": true },
    "esp32_command": { ".read": true,           ".write": "auth != null" },

    "hisense":       { ".read": "auth != null", ".write": "auth != null" },
    "notifications": { ".read": "auth != null", ".write": false, ".indexOn": ["ts"] }
  }
}
